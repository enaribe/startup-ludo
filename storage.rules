rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'startupludo@concree.com' ||
        request.auth.token.admin == true
      );
    }

    // Compte annonceur : MEME claim que dans firestore.rules, pour que les deux
    // jeux de regles ne puissent pas diverger sur qui est annonceur.
    function isSponsor() {
      return isAuthenticated() && request.auth.token.sponsor == true;
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024; // max 5 Mo
    }

    // Documents sources (base de contenu) : PDF, DOCX, MD/TXT, PPTX. Max 25 Mo.
    function isValidDoc() {
      return request.resource.size < 25 * 1024 * 1024 && (
        request.resource.contentType == 'application/pdf'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
        || request.resource.contentType == 'application/msword'
        || request.resource.contentType.matches('text/.*')
        || request.resource.contentType == 'application/octet-stream'
      );
    }

    // Challenge images (bannières, logos) — admin uniquement en écriture, lecture publique
    match /challenges/{programId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Images partenaires (logo, bannière) — admin uniquement en écriture, lecture publique
    match /partners/{partnerId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Images éditions (visuel du popup sponsor) — admin uniquement en écriture, lecture publique
    match /editions/{editionId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Documents sources d'un programme (base de contenu pour la génération) — admin uniquement,
    // documents (PDF/DOCX/MD/TXT/PPTX) jusqu'à 25 Mo. Règle plus spécifique que le wildcard ci-dessous.
    match /programs/{programId}/sources/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isValidDoc();
      allow delete: if isAdmin();
    }

    // Images programmes (hero, bannière, logo, profils) — admin uniquement en écriture, lecture publique.
    // Wildcard récursif pour couvrir les sous-dossiers (ex: programs/<id>/profiles/<profileId>).
    match /programs/{programId}/{path=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Visuels d'une campagne annonceur (logo du cartouche, photo d'habillage).
    //
    // POURQUOI CETTE REGLE EXISTE : le chemin `campaigns/{id}/...` ne
    // correspondait a aucun match et tombait donc dans le refus global du bas
    // de fichier — tout upload de logo echouait en `storage/unauthorized`.
    //
    // `isSponsor()` plutot que `isAdmin()` : un annonceur porte bien
    // `admin: true` en plus de `sponsor: true`, si bien qu'`isAdmin()` aurait
    // « marche » — mais aurait aussi ouvert l'ecriture a TOUT admin (etablissement,
    // enseignant) sur les visuels de n'importe quelle campagne. On ouvre au role
    // qui a une raison metier d'ecrire ici, pas au premier role qui passe.
    //
    // Lecture publique : ces visuels sont affiches dans le jeu, y compris a un
    // joueur non connecte — meme regime que `editions/` juste au-dessus.
    //
    // Le SVG est accepte (`image/*`) car l'interface l'annonce. Un SVG peut
    // porter du script, mais Firebase Storage le sert depuis un domaine
    // distinct de l'application : il ne s'execute donc pas en meme origine, et
    // les visuels sont de toute facon rendus via <img>, qui n'execute rien.
    match /campaigns/{campaignId}/{fileName} {
      allow read: if true;
      allow write: if isSponsor() && isValidImage();
      allow delete: if isSponsor() || isAdmin();
    }

    // Avatars utilisateurs — lecture publique, écriture par le propriétaire uniquement
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated()
        && request.auth.uid == userId
        && isValidImage();
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Tout le reste est interdit
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
